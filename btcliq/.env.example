# Anthropic API key (console.anthropic.com). Optional: the chat uses your Claude login through Claude Code,
# and offers this key only when your plan's limit is reached (or always with --chat api).
ANTHROPIC_API_KEY=

# OKX API key for trading (okx.com → Profile → API). Permissions: Read + Trade only.
# Bind it to your IP address. See SAFETY_RAILS.md.
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
# OKX_DEMO=1    # uncomment to use an OKX demo-trading key instead of a live one

# Obsidian vault with the chat's knowledge notes (default: a bitVault folder next to this project)
# BTCLIQ_VAULT=
# Daily spending cap, in dollars, for the chat's API key fallback (default 2)
# BTCLIQ_KEY_CAP_USD=2
